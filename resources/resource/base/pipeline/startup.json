{
  "AlasStartGame": {
    "recognition": "DirectHit",
    "action": {
      "type": "StartApp",
      "param": {
        "package": "com.bilibili.azurlane"
      }
    },
    "timeout": 90000,
    "post_delay": 3000,
    "next": [
      "AlasMainScreen",
      "AlasTapToContinue",
      "AlasAnnouncementClose",
      "AlasBootBack"
    ],
    "on_error": [
      "AlasStartFailed"
    ]
  },
  "AlasTapToContinue": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "点击屏幕",
          "开始游戏",
          "触摸屏幕"
        ],
        "threshold": 0.3
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": true
      }
    },
    "post_delay": 1500,
    "next": [
      "AlasMainScreen",
      "AlasAnnouncementClose"
    ]
  },
  "AlasAnnouncementClose": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "关闭"
        ],
        "threshold": 0.35
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": true
      }
    },
    "post_delay": 800,
    "next": [
      "AlasMainScreen",
      "AlasTapToContinue"
    ]
  },
  "AlasStartFailed": {
    "recognition": "DirectHit",
    "action": "StopTask",
    "timeout": 1000
  },
  "AlasBootBack": {
    "recognition": "DirectHit",
    "action": {
      "type": "ClickKey",
      "param": {
        "key": 4
      }
    },
    "post_delay": 900,
    "max_hit": 3,
    "next": [
      "AlasMainScreen",
      "AlasTapToContinue"
    ]
  }
}
